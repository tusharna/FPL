# INTELLIGENCE_FPL_CACHE_MS=300000
# INTELLIGENCE_FIXTURE_CACHE_MS=600000
# INTELLIGENCE_NEWS_CACHE_MS=900000
# INTELLIGENCE_PRICE_CACHE_MS=1800000

# Optional app URL for email CTA links
