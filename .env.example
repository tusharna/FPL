FPL_ENTRY_ID=3944035

# Phase 3 AI explanation layer (server-side only). Leave blank to use deterministic fallback.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=60000

# Phase 4 history persistence (server-side only). Never expose the service role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

